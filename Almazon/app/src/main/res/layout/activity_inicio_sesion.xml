<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo3"
    tools:context=".InicioSesion">

    <ImageView
        android:id="@+id/btn_login2"
        android:layout_width="250dp"
        android:layout_height="100dp"
        android:layout_marginTop="88dp"
        android:onClick="iniciarSesion"
        app:layout_constraintEnd_toEndOf="@+id/pass1"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/pass1"
        app:layout_constraintTop_toBottomOf="@+id/pass1"
        app:srcCompat="@drawable/btn_inicia_sesion" />

    <EditText
        android:id="@+id/usuario1"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_marginTop="208dp"
        android:background="@android:drawable/editbox_background"
        android:ems="10"
        android:hint="@string/et_user"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/pass1"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_marginTop="60dp"
        android:background="@android:drawable/editbox_background"
        android:ems="10"
        android:hint="@string/et_pass"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="@+id/usuario1"
        app:layout_constraintStart_toStartOf="@+id/usuario1"
        app:layout_constraintTop_toBottomOf="@+id/usuario1" />

    <ImageView
        android:id="@+id/btn_volver1"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:onClick="volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/btn_volver" />
</androidx.constraintlayout.widget.ConstraintLayout>